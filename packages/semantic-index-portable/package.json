{
  "name": "@phalanx/hoplon-semantic-index-portable",
  "version": "0.1.0",
  "description": "Optional portable semantic index adapter package for Hoplon lexical-only degraded search.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@phalanx/hoplon": "^0.4.0"
  },
  "devDependencies": {
    "@phalanx/hoplon": "file:../..",
    "@types/node": "^20.11.30",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
