    "test:integration": "RUN_INTEGRATION=1 npx vitest run tests/integration.test.ts"
  },
  "peerDependencies": {
    "@phalanx/hoplon": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
