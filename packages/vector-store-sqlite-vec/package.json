{
  "name": "@phalanx/hoplon-vector-store-sqlite-vec",
  "version": "0.1.0",
  "description": "Optional native performance-tier semantic index adapter package for Hoplon using node:sqlite and sqlite-vec.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
